# คัดลอกไฟล์นี้เป็น .env แล้วใส่ค่าจริง (ไฟล์ .env ห้ามขึ้น GitHub)
# แก้ค่าในไฟล์ .env แล้วต้องหยุด (Ctrl+C) และรัน npm run dev ใหม่

# true = ใช้ข้อมูลปลอม (ไม่ต่อ server), false = เรียก server จริง — แยก 2 ฝั่ง
# หน้า staff (/admin) — server ทำ S1–S11 ครบแล้ว
VITE_USE_MOCK_ADMIN=false
# หน้าผู้ป่วย (/liff) — server ทำ U1–U11 ครบแล้ว (ขั้น N) · true = กลับไปใช้ข้อมูลปลอม (เมนูทดสอบ /liff)
VITE_USE_MOCK_LIFF=false

# LIFF ID จาก LINE Developers Console (LINE Login channel "Clinicfamily Login" > แท็บ LIFF) — ใส่แล้วหน้าผู้ป่วยใช้ LINE จริงเสมอ
# เช่น 2011982974-AbCdEfGh (ไม่ลับ) · ค่าเดียวกับ LIFF_ID ใน server/.env
VITE_LIFF_ID=

# บัตรทดสอบ (ใช้เฉพาะตอน VITE_LIFF_ID ว่าง) — เปิดหน้าผู้ป่วยบนคอมโดยไม่ต้องมี LINE
# test:<line_user_id> เช่น test:new-01 · server ต้องตั้ง ALLOW_TEST_TOKEN=true · วันเดโม (ใส่ LIFF ID แล้ว) ไม่ถูกใช้
VITE_TEST_LINE_TOKEN=test:new-01

# ชื่อและเบอร์คลินิก (แสดงในหน้ายินยอม PDPA) — เปิดเผยได้ ไม่ใช่ความลับ
VITE_CLINIC_NAME=คลินิกครอบครัว
VITE_CLINIC_PHONE=0845969924