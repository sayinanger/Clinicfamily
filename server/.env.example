# แบบฟอร์มค่าตั้งของ server — ไฟล์นี้ขึ้น GitHub ได้ (ไม่มีค่าลับ)
# วิธีใช้: ก๊อปไฟล์นี้เป็น server/.env (ไฟล์ .env ไม่ขึ้น GitHub) แล้วเติมค่าจริงใน .env เท่านั้น
# แก้ .env แล้วต้องหยุด server (Ctrl+C) แล้ว npm run dev ใหม่ ถึงจะอ่านค่าใหม่

# ที่อยู่ฐานข้อมูล Supabase + รหัสผ่าน (ค่าลับ — ห้าม commit ห้ามวางในแชท)
# หาได้ที่ Supabase → ปุ่ม Connect → เลือก "Session pooler" → ก๊อป แล้วแทน [YOUR-PASSWORD] ด้วยรหัสที่จดไว้ (เอาวงเล็บ [ ] ออกด้วย)
# หน้าตา: postgresql://postgres.qchulspybnsyowyqckzb:รหัส@aws-….pooler.supabase.com:5432/postgres
DATABASE_URL=

# พอร์ตของ server (ไม่ใส่ = 3000) — ถ้าเปลี่ยน ต้องแก้ proxy ใน client/vite.config.js ให้ตรงกันด้วย
PORT=3000

# รหัสผ่าน staff สำหรับ login หน้า admin (ค่าลับ — ห้าม commit ห้ามวางในแชท)
# ใช้ตอน npm run db:seed เท่านั้น: seed บดเป็น bcrypt hash แล้วเก็บในตาราง staff (ไม่เก็บรหัสจริง)
# เปลี่ยนรหัส = แก้ค่านี้ → npm run db:reset → npm run db:seed (username คือ staff)
SEED_STAFF_PASSWORD=

# คีย์ลับประทับตรา cookie login ของ staff (ค่าลับ — ห้าม commit ห้ามวางในแชท) — ไม่มี = server ไม่ยอมเปิด
# สร้างด้วยคำสั่ง (รันใน Terminal ที่ไหนก็ได้) แล้วก๊อปผลลัพธ์มาใส่หลังเครื่องหมาย =
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# เปลี่ยนค่า = ทุกคนที่ login อยู่หลุดทันที (ต้อง login ใหม่)
SESSION_SECRET=

# ---------- ยืนยันตัวตนผู้ป่วยด้วย LINE (ไม่ลับ — ขั้น L / สัปดาห์ 4) ----------
# Channel ID ของ LINE Login channel "Clinicfamily Login" (LINE Developers → Provider Clinicfamily → แท็บ Basic settings)
# server ส่งให้ LINE ตอนตรวจ ID token ของผู้ป่วย · ไม่ใส่ = ผู้ป่วยที่ใช้ LINE จริงเข้าไม่ได้
LINE_LOGIN_CHANNEL_ID=
# true = รับบัตรทดสอบใน Postman เช่น header  Authorization: Bearer test:seed-01  (= ผู้ป่วย seed-01)
# ใช้ตอนพัฒนาเท่านั้น · ⚠️ วันเดโมต้องเป็น false (เช็กได้ที่ /api/health → testToken)
ALLOW_TEST_TOKEN=false

# ---------- LINE Messaging API (รอบ LINE ชุด O) ----------
# LINE Developers → Provider Clinicfamily → Messaging API channel "คลินิกครอบครัว"
# Channel secret (ค่าลับ — ห้าม commit ห้ามวางในแชท) — แท็บ Basic settings → Channel secret
#   ใช้ตรวจว่า webhook มาจาก LINE จริง · ไม่ใส่ = รับ webhook ไม่ได้
LINE_CHANNEL_SECRET=
# Channel access token แบบ long-lived (ค่าลับ — ห้าม commit ห้ามวางในแชท) — แท็บ Messaging API → Channel access token → Issue
#   ใช้ส่ง/ตอบข้อความ + สร้าง Rich Menu (npm run richmenu)
LINE_CHANNEL_ACCESS_TOKEN=
# true = ส่งข้อความยืนยันจอง/ยกเลิก/เลื่อนเข้า LINE จริง (นับโควตาข้อความของ OA)
# false = พิมพ์ลง Terminal แทน (ทดสอบด้วย Postman/บัตรทดสอบไม่เสียโควตา) · การตอบปุ่มเมนูไม่ขึ้นกับค่านี้ (ไม่นับโควตา)
LINE_PUSH_ENABLED=false
# LIFF ID (ไม่ลับ — ค่าเดียวกับ VITE_LIFF_ID ใน client/.env) ใช้สร้างลิงก์ปุ่ม Rich Menu และลิงก์ในข้อความ
LIFF_ID=

# ---------- ข้อมูลคลินิก (ไม่ลับ — ขั้น M) ----------
# เบอร์โทรคลินิก แสดงในหน้า "นัดของฉัน" ตอนยกเลิก/เลื่อนนัดไม่ได้แล้ว + ข้อความ LINE ต้อนรับ/ติดต่อคลินิก
# ไม่ใส่ = server เตือนตอนเปิด และหน้าเว็บไม่มีเบอร์ให้โทร
CLINIC_PHONE=

# ---------- โหมดเดโม (ไม่ลับ) ----------
# DEMO_MODE=true เปิดฟีเจอร์เดโม (ใช้ DEMO_NOW ได้, ปุ่มส่งเตือนทันทีในสัปดาห์ 5) · ใช้งานปกติ = false
DEMO_MODE=false
# เวลาเริ่มของนาฬิกาเดโม (เวลาไทย YYYY-MM-DD HH:MM เช่น 2026-10-17 07:12) — ว่าง = ใช้เวลาจริง
# ใช้ได้เฉพาะเมื่อ DEMO_MODE=true · นาฬิกาเดินต่อจากเวลานี้ตั้งแต่เปิด server (รีสตาร์ท = เริ่มใหม่)
DEMO_NOW=

# ---------- ค่าเวลาของกฎคลินิก (ไม่ลับ — ใช้ตั้งแต่ขั้น H / สัปดาห์ 4) ----------
# เวลาถือคิว (วินาที) ปกติ 300 = 5 นาที · เดโมใช้ 30 จะได้ไม่ต้องรอนาน
HOLD_SECONDS=300
# ถือคิวได้เมื่อเหลือเวลาก่อนหมดสิทธิ์ยืนยันอย่างน้อยกี่วินาที
HOLD_MIN_SECONDS=60
# ต้องยืนยันการจองก่อนเวลานัดอย่างน้อยกี่นาที
BOOKING_CUTOFF_MINUTES=10
# ยกเลิก/เลื่อนนัดได้ถึงก่อนเวลานัดกี่นาที
CHANGE_CUTOFF_MINUTES=15
# จองห่างจากเวลานัดน้อยกว่ากี่ชั่วโมง = นัดกระชั้น (ไม่ส่งเตือน)
SHORT_NOTICE_HOURS=3
