# แบบฟอร์มค่าตั้งของ server — ไฟล์นี้ขึ้น GitHub ได้ (ไม่มีค่าลับ)
# วิธีใช้: ก๊อปไฟล์นี้เป็น server/.env (ไฟล์ .env ไม่ขึ้น GitHub) แล้วเติมค่าจริงใน .env เท่านั้น
# แก้ .env แล้วต้องหยุด server (Ctrl+C) แล้ว npm run dev ใหม่ ถึงจะอ่านค่าใหม่

# ที่อยู่ฐานข้อมูล Supabase + รหัสผ่าน (ค่าลับ — ห้าม commit ห้ามวางในแชท)
# หาได้ที่ Supabase → ปุ่ม Connect → เลือก "Session pooler" → ก๊อป แล้วแทน [YOUR-PASSWORD] ด้วยรหัสที่จดไว้ (เอาวงเล็บ [ ] ออกด้วย)
# หน้าตา: postgresql://postgres.qchulspybnsyowyqckzb:รหัส@aws-….pooler.supabase.com:5432/postgres
DATABASE_URL=

# พอร์ตของ server (ไม่ใส่ = 3000) — ถ้าเปลี่ยน ต้องแก้ proxy ใน client/vite.config.js ให้ตรงกันด้วย
PORT=3000

# รหัสผ่าน staff สำหรับ login หน้า admin (ค่าลับ — ห้าม commit ห้ามวางในแชท)
# ใช้ตอน npm run db:seed เท่านั้น: seed บดเป็น bcrypt hash แล้วเก็บในตาราง staff (ไม่เก็บรหัสจริง)
# เปลี่ยนรหัส = แก้ค่านี้ → npm run db:reset → npm run db:seed (username คือ staff)
SEED_STAFF_PASSWORD=
